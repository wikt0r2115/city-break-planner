# Spring Boot nie wczytuje pliku .env automatycznie; wyeksportuj zmienne w powłoce.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_DATASOURCE_URL=jdbc:sqlite:./city-break-planner.db
APP_FRONTEND_BASE_URL=http://localhost:5173
# Testowa sekcja rzeczywistych noclegów OBO; działa również bez klucza.
APP_OBO_ENABLED=true
APP_OBO_TIMEOUT_SECONDS=25
# Poufny klucz opcjonalny, wyłącznie dla backendu.
OBO_API_KEY=
