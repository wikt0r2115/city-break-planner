# Spring Boot nie wczytuje pliku .env automatycznie; wyeksportuj zmienne w powłoce.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_DATASOURCE_URL=jdbc:sqlite:./city-break-planner.db
# Klucze dostawców dodajemy po potwierdzeniu integracji w SOL-115/SOL-119.
APP_DATA_MODE=live
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_SOURCE_TIMEOUT_SECONDS=3
# APP_DATA_MODE=demo uruchamia wyłącznie jawnie oznaczone, wymyślone dane testowe.
