# Optional Compose configuration. Defaults work without copying this file.
# Use: docker compose --env-file .env.docker up --build -d
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
# When unset, links and CORS use http://localhost:${APP_PORT} automatically.
# APP_FRONTEND_BASE_URL=https://planner.example.com
APP_DATA_MODE=live
APP_SOURCE_TIMEOUT_SECONDS=3
# APP_DATA_MODE=demo enables explicitly fictional test data.
